--- !u!114 &286402992
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 286402988}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c77e6d34e2db4005a4c50d215a2388a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  musicSource: {fileID: 286402990}
  sfxSource: {fileID: 286402989}
  dialogueSource: {fileID: 286402991}
  glitchSoundEffect: {fileID: 8300000, guid: 3c3eb23eae0c54ee59d8b9f1965b4919, type: 3}
  blockPickUp: {fileID: 8300000, guid: f0d0752ad8b594a118794f85e7a8f1b5, type: 3}
  whiteboard: {fileID: 8300000, guid: 1bf8aa0ee0a1e441e8b424db7853d092, type: 3}
  subtitlePanel: {fileID: 1388225404}
  subtitleText: {fileID: 68434389}
  isMusicOn: 1
  isDialogueOn: 1
  line:
  - line: '*Static*... Welcome to your first day on the job Alan. We are moderately
      happy you applied to our program and will try to make this a unique experience
      for you. '
    clip: {fileID: 8300000, guid: fab30cb668ffe489f890f04f52b9d420, type: 3}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 12.5
  - line: "You\u2019ve been carefully selected to test our new project V.I.S.T.A.
      It's a complicated system but I\u2019m sure you\u2019ll figure it out."
    clip: {fileID: 8300000, guid: 1e62bf1faef194406befba1c4d8b006a, type: 3}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 8.5
  - line: "I see you\u2019ve discovered the packing warehouse Alan. We package all
      our equipment and perishables here."
    clip: {fileID: 8300000, guid: 4bd98b615506247b4859c96bfd192009, type: 3}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 7.5
  - line: ' Could you do your job and move the whiteboards? Make sure not to break
      anything. '
    clip: {fileID: 0}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 5
