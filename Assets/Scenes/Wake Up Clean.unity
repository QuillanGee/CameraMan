  subtitleText: {fileID: 141629306}
  isMusicOn: 0
  isDialogueOn: 0
  line:
  - line: '*Static*... Welcome to your first day on the job Alan. We are super happy
      you applied to our program and will do our best to make this an enjoyable experience
      for you.'
    clip: {fileID: 8300000, guid: b5786a92c6d474ce7aa4e0183cc78ce9, type: 3}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 10
  - line: "Please don\u2019t feel pressure to enjoy this job experience, as we do
      not want to control your feelings and emotions here at Kannon Labs. "
    clip: {fileID: 0}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 8.5
  - line: "You\u2019ve been hired to test our new virtual integration project V.I.S.T.A.
      A beta testing project that integrates your 3D physical self with a 2D version
      of you through our security cameras."
    clip: {fileID: 8300000, guid: 5910faa2a6e9b40e194108c18adb00a0, type: 3}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 10.5
  - line: "There\u2019s a TV in each room to display what you look like in 2D. "
    clip: {fileID: 0}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 5
  - line: Press 'F' To Toggle 2D
    clip: {fileID: 0}
    colorText: {r: 1, g: 1, b: 1, a: 0}
    time: 7
